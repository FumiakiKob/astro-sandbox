{
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  // Astroファイル用の設定
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // JSONファイル用の設定
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // コメントが許可されているJSON（settings.jsonなど）用の設定
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
